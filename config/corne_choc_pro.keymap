#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    combos {
        compatible = "zmk,combos";

        quit_program {
            bindings = <&kp LA(F4)>;
            key-positions = <40 1>;
            layers = <1 0>;
        };
    };

    behaviors {
        um_A: um_A {
            compatible = "zmk,behavior-mod-morph";
            label = "UM_A";
            bindings = <&kp A>, <&kp RA(Q)>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            keep-mods = <(MOD_RALT)>;
        };

        um_S: um_S {
            compatible = "zmk,behavior-mod-morph";
            label = "UM_S";
            bindings = <&kp S>, <&kp RA(S)>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            keep-mods = <(MOD_RALT)>;
        };

        um_U: um_U {
            compatible = "zmk,behavior-mod-morph";
            label = "UM_U";
            bindings = <&kp U>, <&kp RA(Y)>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            keep-mods = <(MOD_RALT)>;
        };

        um_O: um_O {
            compatible = "zmk,behavior-mod-morph";
            label = "UM_O";
            bindings = <&kp O>, <&kp RA(P)>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            keep-mods = <(MOD_RALT)>;
        };

        sf: space_fn {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_FN";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_ON";
            #binding-cells = <1>;
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        hold_tap: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        quit: quit_programm {
            compatible = "zmk,behavior-mod-morph";
            label = "QUIT";
            bindings = <&kp Q>, <&kp LA(F4)>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        refresh: refresh {
            compatible = "zmk,behavior-mod-morph";
            label = "REFRESH";
            bindings = <&kp R>, <&kp F5>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        hml_a: hml_a {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_A";
            bindings = <&kp>, <&um_A>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <39 7 21 22 23 24 25 26 27 34 35 36 37 38 39 43 44 45 8 9 10 11 12 13>;
            flavor = "balanced";
            hold-while-undecided;
            hold-trigger-on-release;
            require-prior-idle-ms = <125>;
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
        };

        hmr_u: hmr_u {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_U";
            bindings = <&kp>, <&um_U>;

            #binding-cells = <2>;
            flavor = "balanced";
            hold-while-undecided;
            hold-trigger-on-release;
            require-prior-idle-ms = <125>;
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 40 41 42>;
        };

        td_tab_esc: td_tab_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_TAB_ESC";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp ESC>;
        };

        hml_s: hml_s {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_S";
            bindings = <&kp>, <&um_S>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <39 7 21 22 23 24 25 26 27 34 35 36 37 38 39 43 44 45 8 9 10 11 12 13>;
            flavor = "balanced";
            hold-while-undecided;
            hold-trigger-on-release;
            require-prior-idle-ms = <125>;
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
        };

        hmr_o: hmr_o {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_O";
            bindings = <&kp>, <&um_O>;

            #binding-cells = <2>;
            flavor = "balanced";
            hold-while-undecided;
            hold-trigger-on-release;
            require-prior-idle-ms = <125>;
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 40 41 42>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <39 7 21 22 23 24 25 26 27 34 35 36 37 38 39 43 44 45 8 9 10 11 12 13>;
            flavor = "balanced";
            hold-while-undecided;
            hold-trigger-on-release;
            require-prior-idle-ms = <125>;
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            hold-while-undecided;
            hold-trigger-on-release;
            require-prior-idle-ms = <125>;
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 40 41 42>;
        };

        rgb_tog: rgb_tog {
            compatible = "zmk,behavior-mod-morph";
            label = "RGB_TOG";
            bindings = <&rgb_ug RGB_TOG>, <&rgb_ug RGB_OFF>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rgb_mod: rgb_mod {
            compatible = "zmk,behavior-mod-morph";
            label = "RGB_MOD";
            bindings = <&rgb_ug RGB_EFF>, <&rgb_ug RGB_EFR>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rgb_hue: rgb_hue {
            compatible = "zmk,behavior-mod-morph";
            label = "RGB_HUE";
            bindings = <&rgb_ug RGB_HUI>, <&rgb_ug RGB_HUD>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rgb_sat: rgb_sat {
            compatible = "zmk,behavior-mod-morph";
            label = "RGB_SAT";
            bindings = <&rgb_ug RGB_SAI>, <&rgb_ug RGB_SAD>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rgb_val: rgb_val {
            compatible = "zmk,behavior-mod-morph";
            label = "RGB_VAL";
            bindings = <&rgb_ug RGB_SPI>, <&rgb_ug RGB_SPD>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        win_mute: win_mute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LG(K))>;
            label = "WIN_MUTE";
        };

        win_copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RC(C)>;
            label = "COPY";
        };

        win_paste: win_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RC(V)>;
            label = "WIN_PASTE";
        };

        win_undo: win_undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RC(Z)>;
            label = "WIN_UNDO";
        };

        win_redo: win_redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RC(Y)>;
            label = "WIN_REDO";
        };

        win_cut: win_cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RC(X)>;
            label = "WIN_CUT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak_layer {
            bindings = <
&kp TAB                           &kp Q                 &kp W             &kp F               &kp P          &kp B      &trans  &trans  &kp J        &kp L            &um_U         &kp Y             &kp SEMI               &kp BSPC
&hold_tap LEFT_CONTROL BACKSPACE  &hml_a LGUI LEFT_GUI  &hml RIGHT_ALT R  &hml_s LCTRL RCTRL  &hml RSHIFT T  &kp G      &trans  &trans  &kp M        &hmr LSHIFT N    &hmr LCTRL E  &hmr RIGHT_ALT I  &hmr_o RGUI RIGHT_GUI  &kp SQT
&kp LEFT_SHIFT                    &kp Z                 &kp X             &kp C               &kp D          &kp V                      &kp K        &kp H            &kp COMMA     &kp DOT           &kp FSLH               &kp RSHFT
                                                                          &lt 6 ESC           &lt 2 SPACE    &lt 2 TAB                  &lt 4 ENTER  &lt 3 BACKSPACE  &lt 5 DEL
            >;

            label = "COLEMAK";
        };

        qwerty_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&td_tab_esc                       &kp Q          &kp W               &kp E         &refresh       &kp T      &trans  &trans  &kp Y        &um_U            &kp I         &um_O             &kp P           &kp BSPC
&hold_tap LEFT_CONTROL BACKSPACE  &hml_a LGUI 0  &hml_s RIGHT_ALT 0  &hml LCTRL D  &hml LSHIFT F  &kp G      &trans  &trans  &kp H        &hmr RSHIFT J    &hmr RCTRL K  &hmr RIGHT_ALT L  &hmr RGUI SEMI  &kp SQT
&kp LEFT_SHIFT                    &kp Z          &kp X               &kp C         &kp V          &kp B                      &kp N        &kp M            &kp COMMA     &kp DOT           &kp FSLH        &kp RSHFT
                                                                     &lt 6 ESC     &lt 2 SPACE    &lt 2 TAB                  &lt 4 ENTER  &lt 3 BACKSPACE  &lt 5 DEL
            >;
        };

        navigation_layer {
            display-name = "NAV";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
&trans  &none      &none     &none      &none       &none   &trans  &trans  &win_redo  &kp HOME       &kp UP    &kp END    &kp PG_UP  &kp DELETE
&trans  &kp LGUI   &kp RALT  &kp LCTRL  &kp LSHFT   &kp N0  &trans  &trans  &kp CAPS   &kp LEFT       &kp DOWN  &kp RIGHT  &kp PG_DN  &trans
&trans  &win_undo  &win_cut  &win_copy  &win_paste  &none                   &none      &none          &none     &none      &none      &trans
                             &none      &trans      &none                   &kp ENTER  &kp BACKSPACE  &kp DEL
            >;
        };

        num_layer {
            display-name = "NUM";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
&none  &kp LEFT_BRACKET  &kp N7  &kp N8     &kp N9  &kp RIGHT_BRACKET  &none  &none  &none          &none       &none      &none     &none     &none
&none  &kp SEMI          &kp N4  &kp N5     &kp N6  &kp EQUAL          &none  &none  &none          &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &kp GRAVE         &kp N1  &kp N2     &kp N3  &kp MINUS                        &none          &none       &none      &none     &none     &none
                                 &kp COMMA  &kp N0  &kp DOT                          &kp BACKSLASH  &trans      &none
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
&none  &kp LBRC   &kp AMPS  &kp ASTERISK  &kp LPAR   &kp RBRC   &none  &none  &none   &none       &none      &none     &none     &none
&none  &kp COLON  &kp DLLR  &kp PRCNT     &kp CARET  &kp PLUS   &none  &none  &none   &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &kp TILDE  &kp EXCL  &kp AT        &kp HASH   &kp PIPE                 &none   &none       &none      &none     &none     &none
                            &kp LPAR      &kp RPAR   &kp UNDER                &trans  &none       &none
            >;
        };

        fun_layer {
            display-name = "FUN";
            bindings = <
&none  &kp F12  &kp F7  &kp F8     &kp F9     &kp PRINTSCREEN  &none  &none  &none  &none       &none      &none     &none     &none
&none  &kp F11  &kp F4  &kp F5     &kp F6     &kp SCROLLLOCK   &none  &none  &none  &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &kp F10  &kp F1  &kp F2     &kp F3     &kp PAUSE_BREAK                &none  &none       &none      &none     &none     &none
                        &kp K_APP  &kp SPACE  &kp TAB                        &none  &none       &trans
            >;
        };

        media_layer {
            display-name = "MEDIA";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &rgb_tog    &rgb_mod          &rgb_hue      &rgb_sat      &rgb_val    &none
&tog_on 1   &kp LGUI      &kp RALT      &kp RCTRL     &kp RSHFT     &none           &trans  &trans  &kp C_MUTE  &kp C_PREV        &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &none
&tog_off 1  &none         &none         &sys_reset    &bootloader   &studio_unlock                  &none       &win_mute         &none         &none         &none       &none
                                        &trans        &none         &none                           &kp C_STOP  &kp C_PLAY_PAUSE  &kp C_MUTE
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
