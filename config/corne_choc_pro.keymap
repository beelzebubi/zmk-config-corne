#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    combos {
        compatible = "zmk,combos";

        quit_program {
            bindings = <&kp LA(F4)>;
            key-positions = <40 1>;
        };
    };

    behaviors {
        um_A: um_A {
            compatible = "zmk,behavior-mod-morph";
            label = "UM_A";
            bindings = <&kp A>, <&kp RA(Q)>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            keep-mods = <(MOD_RALT)>;
        };

        um_S: um_S {
            compatible = "zmk,behavior-mod-morph";
            label = "UM_S";
            bindings = <&kp S>, <&kp RA(S)>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            keep-mods = <(MOD_RALT)>;
        };

        um_U: um_U {
            compatible = "zmk,behavior-mod-morph";
            label = "UM_U";
            bindings = <&kp U>, <&kp RA(Y)>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            keep-mods = <(MOD_RALT)>;
        };

        um_O: um_O {
            compatible = "zmk,behavior-mod-morph";
            label = "UM_O";
            bindings = <&kp O>, <&kp RA(P)>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            keep-mods = <(MOD_RALT)>;
        };

        sf: space_fn {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_FN";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_ON";
            #binding-cells = <1>;
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        hold_tap: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        quit: quit_programm {
            compatible = "zmk,behavior-mod-morph";
            label = "QUIT";
            bindings = <&kp Q>, <&kp LA(F4)>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        refresh: refresh {
            compatible = "zmk,behavior-mod-morph";
            label = "REFRESH";
            bindings = <&kp R>, <&kp F5>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&none>, <&none>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <39 7 21 22 23 24 25 26 27 34 35 36 37 38 39 43 44 45 8 9 10 11 12 13>;
            flavor = "balanced";
            hold-while-undecided;
            hold-trigger-on-release;
            require-prior-idle-ms = <125>;
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&none>, <&none>;

            #binding-cells = <2>;
            flavor = "balanced";
            hold-while-undecided;
            hold-trigger-on-release;
            require-prior-idle-ms = <125>;
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 40 41 42>;
        };

        td_tab_esc: td_tab_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_TAB_ESC";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp ESC>;
        };
    };

    macros {
        win_mute: win_mute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LG(K))>;
            label = "WIN_MUTE";
        };

        win_copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RC(C)>;
            label = "COPY";
        };

        win_paste: win_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RC(V)>;
            label = "WIN_PASTE";
        };

        win_undo: win_undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RC(Z)>;
            label = "WIN_UNDO";
        };

        win_redo: win_redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RC(Y)>;
            label = "WIN_REDO";
        };

        win_cut: win_cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RC(X)>;
            label = "WIN_CUT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&td_tab_esc                       &quit  &kp W  &kp E     &refresh     &kp T      &trans  &trans  &kp Y        &um_U        &kp I          &um_O    &kp P     &kp BSPC
&hold_tap LEFT_CONTROL BACKSPACE  &um_A  &um_S  &kp D     &kp F        &kp G      &trans  &trans  &kp H        &kp J        &kp K          &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT                    &kp Z  &kp X  &kp C     &kp V        &kp B                      &kp N        &kp M        &kp COMMA      &kp DOT  &kp FSLH  &kp ESC
                                                &kp LGUI  &sf 2 SPACE  &sf 2 RET                  &sf 3 ENTER  &sf 3 SPACE  &kp RIGHT_ALT
            >;
        };

        colemak_layer {
            bindings = <
&kp TAB                           &quit  &kp W     &kp F         &kp P        &kp B        &trans  &trans  &kp J        &kp L        &um_U          &kp Y    &kp SEMI  &kp BSPC
&hold_tap LEFT_CONTROL BACKSPACE  &um_A  &refresh  &um_S         &kp T        &kp G        &trans  &trans  &kp M        &kp N        &kp E          &kp I    &um_O     &kp SQT
&kp LEFT_SHIFT                    &kp Z  &kp X     &kp C         &kp D        &kp V                        &kp K        &kp H        &kp COMMA      &kp DOT  &kp FSLH  &kp ESC
                                                   &kp LEFT_GUI  &sf 2 SPACE  &sf 2 ENTER                  &sf 3 ENTER  &sf 3 SPACE  &kp RIGHT_ALT
            >;

            label = "COLEMAK";
        };

        lower_layer {
            display-name = "LOWER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
&trans  &kp N1        &kp N2    &kp N3     &kp N4      &kp N5  &trans  &trans  &win_redo  &kp HOME  &kp UP    &kp END    &none  &kp DELETE
&trans  &kp NUMBER_6  &kp N7    &kp N8     &kp N9      &kp N0  &trans  &trans  &none      &kp LEFT  &kp DOWN  &kp RIGHT  &none  &trans
&trans  &win_undo     &win_cut  &win_copy  &win_paste  &none                   &none      &none     &none     &none      &none  &trans
                                &trans     &trans      &trans                  &trans     &trans    &trans
            >;
        };

        raise_layer {
            display-name = "RAISE";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &trans  &trans  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &trans    &trans  &trans    &trans    &trans     &trans  &trans  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &trans    &trans  &trans    &trans    &trans                     &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                          &trans    &trans    &trans                     &trans     &trans     &trans
            >;
        };

        adjust_layer {
            display-name = "ADJUST";
            bindings = <
&kp F1      &kp F2        &kp F3           &kp F4        &kp F5        &kp F6          &trans  &trans  &kp F7            &kp F8      &kp F9        &kp F10       &kp F11     &kp F12
&tog_on 1   &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &kp C_MUTE        &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &none
&tog_off 1  &bt BT_CLR    &rgb_ug RGB_TOG  &sys_reset    &bootloader   &studio_unlock                  &kp C_PLAY_PAUSE  &win_mute   &none         &none         &none       &none
                                           &trans        &trans        &trans                          &trans            &trans      &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        ADJUST {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};
